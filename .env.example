# ── NovaPilot 飞书五合一集成(全部可选,不配置则离线确定性运行不受影响) ──

# 飞书开放平台自建应用凭证(open.feishu.cn 开发者后台)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 多维表格:app_token 为表格链接里的 base 标识
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_CARDS=决策卡
FEISHU_BITABLE_TABLE_EVENTS=质量事件

# 企业豆包(火山方舟,OpenAI 兼容)
FEISHU_DOUBAO_API_KEY=
FEISHU_DOUBAO_MODEL=doubao-1-5-pro-32k-250115
