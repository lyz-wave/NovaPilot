{
  "name": "novapilot",
  "version": "3.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "model:fetch": "node scripts/fetch-embedding-model.mjs",
    "model:backfill": "vite-node -c vitest.config.ts scripts/backfill-semantic.ts",
    "model:smoke": "node scripts/smoke-semantic.mjs",
    "kb:ingest": "vite-node -c vitest.config.ts scripts/ingest-documents.ts",
    "kb:verify-citations": "vite-node -c vitest.config.ts scripts/verify-citations.ts",
    "review:judge": "vite-node -c vitest.config.ts scripts/judge-review-samples.ts",
    "demo:e2e": "node scripts/demo-e2e.mjs",
    "inject:fault": "vite-node -c vitest.config.ts scripts/inject-fault.ts",
    "blindspot:clusters": "vite-node -c vitest.config.ts scripts/blindspot-clusters.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.4.4",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "playwright": "^1.61.1",
    "postcss": "^8.5.19",
    "typescript": "^5.7.2",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    }
  },
  "optionalDependencies": {
    "@langchain/langgraph": "^1.4.14"
  }
}
